# Создаётся install.sh. Реальный .env содержит секреты, не коммить его.
COMPOSE_PROJECT_NAME=dnd-ai-arahort
DND_INSTALL_MODE=remote
DND_IMAGE=GENERATED_BY_INSTALLER
DND_VERSION=0.1.0
# Автоматически из release-source.json опубликованного установщика.
DND_REPOSITORY=
DND_STATE_DIR=/var/lib/dnd-ai-arahort
PG_PASSWORD=GENERATED_BY_INSTALLER
DND_SESSION_SECRET=GENERATED_BY_INSTALLER
DND_UPDATE_TOKEN=GENERATED_BY_INSTALLER
DND_UPDATER_GID=GENERATED_BY_INSTALLER
DND_MODEL_EFFORT=high
# Временный диагностический лимит модельных этапов одного ответа Мастера или арта.
DND_GEMINI_TIMEOUT_SECONDS=600
# Совместимость старых образов; текущий образ читает root-owned control/maintenance.json через read-only mount.
DND_START_MAINTENANCE=0
PUBLIC_URL=http://192.0.2.10:8080
DND_NETWORK_MODE=http
DND_TRUST_PROXY=0
HTTP_PORT=8080
BIND_IP=0.0.0.0
DND_DOMAIN=
ACME_EMAIL=
# HTTP(S) proxy URL with percent-encoded credentials; empty without proxy.
AGY_PROXY=
